# Frontend app (ksenia-ahmedova.ru) — public URL of Brainy Woodpecker, no trailing slash.
# Set this in Timeweb Frontend environment variables BEFORE build.
# Example: VITE_API_URL=https://brainy-woodpecker-xxxx.twc1.net
VITE_API_URL=

# Backend app (Brainy Woodpecker) — server-only secrets.
# Never prefix these with VITE_ and never put them in frontend code.
# Production Telegram delivery goes through Cloudflare relay, not api.telegram.org.
# Example: TELEGRAM_RELAY_URL=https://ksenia-telegram-relay.marygold60588.workers.dev
TELEGRAM_RELAY_URL=
TELEGRAM_RELAY_SECRET=
# Consultation-only relay (do not reuse for gift/diagnosis/personal_review).
# Example: CONSULTATION_RELAY_URL=https://ksenia-ahmedova-leads-ingress.marygold60588.workers.dev
CONSULTATION_RELAY_URL=
CONSULTATION_RELAY_SECRET=
# Durable lead store via n8n → Google Sheet «заявки» (survives Timeweb redeploys).
# Optional override; server has a default webhook URL if unset.
LEADS_PERSIST_WEBHOOK_URL=
# REQUIRED shared secret for the persist webhook (also stored in n8n workflow staticData).
LEADS_PERSIST_SECRET=
# RF persistent volume mount path on Timeweb (network disk). Without this, cwd/data is ephemeral.
# Example: LEADS_DATA_DIR=/data/leads
LEADS_DATA_DIR=
# Preferred primary durable store: Timeweb S3 (ru-1). When set, leads + retry queues use S3.
S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
MAX_BOT_TOKEN=
MAX_CHAT_ID=

# Optional. SMTP for owner alerts and visitor email replies.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_TO=

# Optional. HTTP or SOCKS proxy for Telegram API when the host blocks api.telegram.org.
# Used only by the backend Telegram request. If unset, the server connects directly.
# Examples:
# TELEGRAM_PROXY=http://user:pass@host:port
# TELEGRAM_PROXY=socks5://host:port
TELEGRAM_PROXY=
