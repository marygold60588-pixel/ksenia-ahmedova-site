# Frontend app (ksenia-ahmedova.ru) — public URL of Brainy Woodpecker, no trailing slash.
# Set this in Timeweb Frontend environment variables BEFORE build.
# Example: VITE_API_URL=https://brainy-woodpecker-xxxx.twc1.net
VITE_API_URL=

# Backend app (Brainy Woodpecker) — server-only secrets.
# Never prefix these with VITE_ and never put them in frontend code.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
